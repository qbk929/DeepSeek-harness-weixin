{
  "name": "deepseek-harness-weixin",
  "version": "0.2.5-workhub.7",
  "description": "Official Weixin iLink text, image, and file bridge for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-weixin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": { "dshTested": ["0.1.5-rc.2", "0.2.1-alpha.1"] }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.rc2.json --noEmit",
    "test": "vitest run tests/approvals.test.ts tests/bridge.test.ts tests/inbound.test.ts tests/index.test.ts tests/login.test.ts tests/markdown-filter.test.ts tests/outbound-files.test.ts tests/preset-compat.test.ts tests/protocol.test.ts tests/util.test.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run check"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "weixin",
    "wechat",
    "ilink",
    "chatbot",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sliverp/DeepSeek-harness-weixin.git"
  },
  "homepage": "https://github.com/sliverp/DeepSeek-harness-weixin#readme",
  "bugs": {
    "url": "https://github.com/sliverp/DeepSeek-harness-weixin/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "qrcode-terminal": "0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-credentials-local": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": ">=0.1.5-rc.2 <0.2.0-0 || 0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.5-rc.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.33.4",
  "ilink_appid": "bot"
}
